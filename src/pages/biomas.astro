<style is:global>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
a{text-decoration:none;color:inherit;}
:root{--deep:#060e09;--forest:#0d1f15;--dark:#142a1d;--green:#1e4d35;--mid:#2d6a4f;--light:#52b788;--gold:#c9a84c;--gold2:#e8c55a;--white:#f4f0e8;--gray:#8a9e8f;--border:rgba(201,168,76,0.18);--fd:'Playfair Display',Georgia,serif;--fa:'Oswald',sans-serif;--fb:'DM Sans',system-ui,sans-serif;--nav:72px;--tr:0.3s cubic-bezier(0.4,0,0.2,1);}
body{background:var(--deep);color:var(--white);font-family:var(--fb);font-weight:300;line-height:1.6;overflow-x:hidden;}
::-webkit-scrollbar{width:5px;}::-webkit-scrollbar-track{background:var(--forest);}::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px;}

.page-hero{padding:calc(var(--nav) + 80px) 5% 80px;position:relative;overflow:hidden;border-bottom:1px solid var(--border);}
.page-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 50%,rgba(45,106,79,.12) 0%,transparent 60%),radial-gradient(ellipse at 10% 80%,rgba(201,168,76,.06) 0%,transparent 40%),var(--deep);}
.ph-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(201,168,76,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(201,168,76,.03) 1px,transparent 1px);background-size:60px 60px;}
.ph-inner{position:relative;z-index:1;max-width:800px;}
.breadcrumb{font-family:var(--fa);font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gray);margin-bottom:1.5rem;display:flex;align-items:center;gap:8px;}
.breadcrumb a{color:var(--gold);transition:opacity var(--tr);}
.breadcrumb a:hover{opacity:.7;}
.page-h1{font-family:var(--fd);font-size:clamp(2.4rem,5vw,4rem);font-weight:900;line-height:1.08;letter-spacing:-.02em;margin-bottom:1.2rem;}
.page-h1 em{font-style:italic;color:var(--gold);}
.page-sub{font-size:1.05rem;color:var(--gray);max-width:620px;line-height:1.75;}
.hero-badges{display:flex;flex-wrap:wrap;gap:10px;margin-top:1.5rem;}
.hbadge{font-family:var(--fa);font-size:.65rem;font-weight:400;letter-spacing:.1em;text-transform:uppercase;background:rgba(201,168,76,.08);border:1px solid var(--border);color:var(--gray);padding:6px 14px;}
.section{padding:80px 5%;}
.section.alt{background:var(--dark);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.stag{font-family:var(--fa);font-size:.7rem;font-weight:400;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:10px;margin-bottom:1rem;}
.stag::before{content:'';width:24px;height:1px;background:var(--gold);}
.sh2{font-family:var(--fd);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:900;line-height:1.1;letter-spacing:-.02em;margin-bottom:2rem;}
.sh2 em{font-style:italic;color:var(--gold);}
.rv{opacity:0;transform:translateY(40px);transition:opacity .7s ease,transform .7s ease;}.rv.on{opacity:1;transform:translateY(0);}
.intro-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:60px;align-items:start;}
.intro-text p{color:var(--gray);line-height:1.8;margin-bottom:1.2rem;font-size:.95rem;}
.intro-text p strong{color:var(--white);font-weight:500;}
.biome-count{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);}
.bc-box{background:var(--forest);padding:28px 20px;text-align:center;}
.bc-num{font-family:var(--fa);font-size:1.8rem;font-weight:700;color:var(--gold);display:block;line-height:1;}
.bc-lbl{font-size:.72rem;color:var(--gray);margin-top:6px;font-family:var(--fa);letter-spacing:.1em;text-transform:uppercase;}
.biomes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);}
.biome-card{background:var(--forest);position:relative;overflow:hidden;padding:0;}
.bc-bar{width:100%;height:3px;background:var(--gold);}
.bc-header{padding:28px 28px 0;display:flex;align-items:center;gap:12px;}
.bc-emoji{font-size:1.6rem;}
.bc-name{font-family:var(--fa);font-size:1rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--white);}
.bc-sub{font-size:.72rem;color:var(--gray);margin-top:2px;letter-spacing:.08em;text-transform:uppercase;font-family:var(--fa);}
.bc-body{padding:16px 28px 28px;}
.bc-desc{font-size:.85rem;color:var(--gray);line-height:1.7;margin-bottom:16px;}
.bc-stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(201,168,76,.07);margin-bottom:16px;}
.bstat{padding:12px;text-align:center;}
.bstat strong{font-family:var(--fa);font-size:.85rem;font-weight:700;color:var(--gold);display:block;}
.bstat span{font-size:.68rem;color:var(--gray);margin-top:2px;display:block;font-family:var(--fa);letter-spacing:.08em;text-transform:uppercase;}
.bc-tags{display:flex;flex-wrap:wrap;gap:6px;}
.bctag{font-family:var(--fa);font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;background:rgba(201,168,76,.1);border:1px solid rgba(201,168,76,.25);color:var(--gold);padding:4px 10px;}
.chart-section{margin-top:1rem;}
.chart-title{font-family:var(--fa);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gray);margin-bottom:1.5rem;}
.bar-item{display:flex;align-items:center;gap:16px;margin-bottom:12px;}
.bar-label{width:140px;font-size:.82rem;color:var(--white);flex-shrink:0;font-family:var(--fa);letter-spacing:.05em;}
.bar-track{flex:1;height:8px;background:rgba(201,168,76,.1);border:1px solid var(--border);overflow:hidden;}
.bar-fill{height:100%;background:var(--gold);width:0;transition:width 1.2s ease;}
.bar-val{width:80px;text-align:right;font-family:var(--fa);font-size:.78rem;color:var(--gold);font-weight:600;}
.pot-table-wrap{overflow-x:auto;}
.pot-table{width:100%;border-collapse:collapse;}
.pot-table thead th{font-family:var(--fa);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);background:var(--forest);padding:14px 16px;text-align:left;border-bottom:2px solid var(--gold);}
.pot-table tbody td{padding:12px 16px;border-bottom:1px solid rgba(201,168,76,.07);font-size:.82rem;color:var(--gray);}
.pt-biome{font-weight:500;color:var(--white);}
.pt-high{color:var(--gold);font-family:var(--fa);font-weight:600;}
.sig-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);}
.sig-card{background:var(--forest);padding:20px 16px;text-align:center;}
.sig-abbr{font-family:var(--fa);font-size:1rem;font-weight:700;color:var(--gold);letter-spacing:.08em;margin-bottom:4px;}
.sig-full{font-size:.72rem;color:var(--gray);line-height:1.5;}
.cta-strip{padding:80px 5%;background:var(--green);border-top:1px solid var(--border);text-align:center;}
.cta-strip h2{font-family:var(--fd);font-size:clamp(1.8rem,3vw,2.6rem);font-weight:900;margin-bottom:1rem;}
.cta-strip h2 em{font-style:italic;color:var(--gold);}
.cta-strip p{color:var(--gray);max-width:540px;margin:0 auto 2rem;line-height:1.75;}
.cta-row{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}
.btn-p{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:var(--deep);font-family:var(--fa);font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:14px 30px;border-radius:2px;transition:all var(--tr);border:none;cursor:pointer;}
.btn-p:hover{background:var(--gold2);transform:translateY(-2px);}
.btn-o{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--white);font-family:var(--fa);font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;padding:14px 30px;border:1px solid rgba(244,240,232,.2);border-radius:2px;transition:all var(--tr);cursor:pointer;}
.btn-o:hover{border-color:var(--gold);color:var(--gold);}
footer{background:var(--forest);border-top:1px solid var(--border);padding:48px 5% 28px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px;}
.foot-logo{font-family:var(--fa);font-weight:700;font-size:1.4rem;letter-spacing:.15em;color:var(--gold);margin-bottom:1rem;}
.foot-desc{font-size:.83rem;color:var(--gray);line-height:1.75;max-width:280px;}
.fcol h4{font-family:var(--fa);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:1.2rem;}
.fcol ul{list-style:none;}
.fcol li{font-size:.83rem;color:var(--gray);padding:6px 0;cursor:pointer;transition:color var(--tr);}
.fcol li:hover{color:var(--white);}
.foot-bot{border-top:1px solid var(--border);padding-top:22px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:.76rem;color:var(--gray);}
.ods-row{display:flex;gap:8px;flex-wrap:wrap;}
.odsbadge{background:var(--forest);border:1px solid var(--border);padding:4px 10px;font-family:var(--fa);font-size:.62rem;letter-spacing:.1em;color:var(--gray);}
.wa-float{position:fixed;right:22px;bottom:22px;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;z-index:1200;box-shadow:0 8px 24px rgba(37,211,102,.35);transition:transform var(--tr),box-shadow var(--tr);cursor:pointer;}
.wa-float:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(37,211,102,.5);}
.wa-float svg{width:30px;height:30px;fill:var(--white);}
@media(max-width:900px){.intro-grid{grid-template-columns:1fr;}.biomes-grid{grid-template-columns:1fr;}.sig-grid{grid-template-columns:1fr 1fr;}.footer-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:540px){.sig-grid{grid-template-columns:1fr;}}
</style>
</head>
<body>

<Header activeNav="biomas" />

<main>
<div class="page-hero">
  <div class="ph-grid"></div>
  <div class="ph-inner">
    <div class="breadcrumb"><a href="/">Home</a> › <span>Biomas Brasileiros</span></div>
    <h1 class="page-h1">Biomas Brasileiros e<br><em>Potencial de Carbono</em></h1>
    <p class="page-sub">Com seis biomas únicos e mais de 850 milhões de hectares, o Brasil detém o maior potencial de geração de créditos de carbono do planeta. Conheça cada bioma e seu papel no mercado global.</p>
  </div>
</div>

<section class="section rv">
  <div class="stag">O Território</div>
  <div class="intro-grid">
    <div class="intro-text">
      <h2 class="sh2">Seis biomas.<br><em>Um potencial imenso.</em></h2>
      <p>O Brasil é formado por <strong>seis biomas distintos</strong> — Amazônia, Caatinga, Cerrado, Pantanal, Mata Atlântica e Pampa — cada um com características próprias, abrigando diferentes tipos de fauna e vegetação.</p>
      <p>Juntos, esses biomas posicionam o Brasil como o <strong>país com maior potencial de geração de créditos de carbono no mundo</strong>, especialmente após a criação do SBCE e os compromissos da COP30.</p>
      <p>A ENSUC opera em <strong>todos os biomas brasileiros</strong>, adaptando a metodologia PAA às características específicas de cada ecossistema para maximizar a geração de créditos e a remuneração do proprietário rural.</p>
    </div>
    <div>
      <div class="biome-count">
        <div class="bc-box"><span class="bc-num">6</span><div class="bc-lbl">Biomas brasileiros</div></div>
        <div class="bc-box"><span class="bc-num">850 M ha</span><div class="bc-lbl">Área territorial</div></div>
        <div class="bc-box"><span class="bc-num">20%</span><div class="bc-lbl">Da biodiversidade mundial</div></div>
        <div class="bc-box"><span class="bc-num">US$ 120 Bi</span><div class="bc-lbl">Potencial de mercado</div></div>
        <div class="bc-box"><span class="bc-num">60 M ha</span><div class="bc-lbl">Área de app e reservas</div></div>
        <div class="bc-box"><span class="bc-num">190+</span><div class="bc-lbl">Espécies endêmicas</div></div>
      </div>
    </div>
  </div>
</section>

<section class="section alt rv">
  <div class="stag">Os Biomas</div>
  <h2 class="sh2">Cada bioma,<br><em>um ativo ambiental único.</em></h2>
  <div class="biomes-grid">
    <div class="biome-card"><div class="bc-bar"></div>
      <div class="bc-header"><span class="bc-emoji">🌳</span><div class="bc-name">Amazônia</div><div class="bc-sub">Floresta Tropical • Norte do Brasil</div></div>
      <div class="bc-body"><p class="bc-desc">O maior bioma do mundo, com 5,5 milhões de km² e a maior biodiversidade do planeta. Regula o clima global e é o principal estoque de carbono florestal do hemisfério Sul.</p>
      <div class="bc-stats"><div class="bstat"><strong>≥ 150</strong><span>tCO₂/ha estocado</span></div><div class="bstat"><strong>REDD+</strong><span>Metodologia principal</span></div></div>
      <div class="bc-tags"><span class="bctag">REDD+</span><span class="bctag">VCS Verra</span><span class="bctag">Manejo Florestal</span><span class="bctag">Alta liquidez</span></div></div>
    </div>
    <div class="biome-card"><div class="bc-bar"></div>
      <div class="bc-header"><span class="bc-emoji">🌵</span><div class="bc-name">Caatinga</div><div class="bc-sub">Semiárido • Nordeste do Brasil</div></div>
      <div class="bc-body"><p class="bc-desc">Único bioma exclusivamente brasileiro, com vegetação adaptada à seca. Altamente ameaçado e ainda subutilizado no mercado de carbono — grande oportunidade para pioneiros.</p>
      <div class="bc-stats"><div class="bstat"><strong>30–50</strong><span>tCO₂/ha estocado</span></div><div class="bstat"><strong>Alto</strong><span>Potencial não explorado</span></div></div>
      <div class="bc-tags"><span class="bctag">Restauração</span><span class="bctag">PSA</span><span class="bctag">Biodiversidade</span><span class="bctag">Mercado crescente</span></div></div>
    </div>
    <div class="biome-card"><div class="bc-bar"></div>
      <div class="bc-header"><span class="bc-emoji">🌾</span><div class="bc-name">Cerrado</div><div class="bc-sub">Savana Tropical • Brasil Central</div></div>
      <div class="bc-body"><p class="bc-desc">A savana mais biodiversa do mundo, considerada um hotspot global. Nasce na região os principais rios brasileiros. Fortemente impactado pelo agronegócio, com alta demanda por projetos de preservação.</p>
      <div class="bc-stats"><div class="bstat"><strong>60–90</strong><span>tCO₂/ha estocado</span></div><div class="bstat"><strong>VCS + Gold</strong><span>Padrões aceitos</span></div></div>
      <div class="bc-tags"><span class="bctag">REDD+</span><span class="bctag">Agropecuária sustentável</span><span class="bctag">ABC Ambiental</span></div></div>
    </div>
    <div class="biome-card"><div class="bc-bar"></div>
      <div class="bc-header"><span class="bc-emoji">🐊</span><div class="bc-name">Pantanal</div><div class="bc-sub">Maior planície alagável • Centro-Oeste</div></div>
      <div class="bc-body"><p class="bc-desc">A maior planície alagável do mundo, com altíssima biodiversidade aquática. Essencial para a regulação hídrica da América do Sul e com imenso potencial de créditos de carbono azul (blue carbon).</p>
      <div class="bc-stats"><div class="bstat"><strong>80–120</strong><span>tCO₂/ha estocado</span></div><div class="bstat"><strong>Blue Carbon</strong><span>Metodologia emergente</span></div></div>
      <div class="bc-tags"><span class="bctag">Blue Carbon</span><span class="bctag">Conservação hídrica</span><span class="bctag">Plan Vivo</span></div></div>
    </div>
    <div class="biome-card"><div class="bc-bar"></div>
      <div class="bc-header"><span class="bc-emoji">🌿</span><div class="bc-name">Mata Atlântica</div><div class="bc-sub">Floresta Tropical • Costa Atlântica</div></div>
      <div class="bc-body"><p class="bc-desc">Um dos biomas mais ameaçados e mais ricos em biodiversidade do mundo. Restam apenas ~12% da cobertura original. Projetos de restauração têm alta valorização no mercado premium de carbono.</p>
      <div class="bc-stats"><div class="bstat"><strong>100–180</strong><span>tCO₂/ha estocado</span></div><div class="bstat"><strong>Premium</strong><span>Preços mais elevados</span></div></div>
      <div class="bc-tags"><span class="bctag">Gold Standard</span><span class="bctag">Restauração</span><span class="bctag">Co-benefícios</span><span class="bctag">Alto valor</span></div></div>
    </div>
    <div class="biome-card"><div class="bc-bar"></div>
      <div class="bc-header"><span class="bc-emoji">🌱</span><div class="bc-name">Pampa</div><div class="bc-sub">Campos Sulinos • Rio Grande do Sul</div></div>
      <div class="bc-body"><p class="bc-desc">Bioma de campos naturais com grande biodiversidade de gramíneas e fauna única. Potencial ainda em desenvolvimento para créditos de carbono via manejo sustentável de pastagens e sequestro no solo.</p>
      <div class="bc-stats"><div class="bstat"><strong>20–40</strong><span>tCO₂/ha estocado</span></div><div class="bstat"><strong>Solo</strong><span>Sequestro no solo</span></div></div>
      <div class="bc-tags"><span class="bctag">Pastagem sustentável</span><span class="bctag">Carbono no solo</span><span class="bctag">ACR</span></div></div>
    </div>
  </div>
</section>

