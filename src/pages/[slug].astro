---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const allSlugs = new Set(posts.map((p) => (p.slug ?? p.id).replace(/\.(md|mdx)$/, '')));

  return posts.map((post) => {
    // Normaliza slug removendo extensão se presente
    const slug = (post.slug ?? post.id).replace(/\.(md|mdx)$/, '');
    const baseSlug = slug.replace(/-(en|es)$/, '');

    const translations: { pt?: string; en?: string; es?: string } = {};
    if (allSlugs.has(baseSlug)) {
      translations.pt = `/${baseSlug}`;
    }
    if (allSlugs.has(`${baseSlug}-en`)) {
      translations.en = `/${baseSlug}-en`;
    }
    if (allSlugs.has(`${baseSlug}-es`)) {
      translations.es = `/${baseSlug}-es`;
    }

    return {
      params: { slug },
      props: { post, translations },
    };
  });
}

const { post, translations } = Astro.props;
const slug = (post.slug ?? post.id).replace(/\.(md|mdx)$/, '');

const isEn = slug.endsWith('-en');
const isEs = slug.endsWith('-es');
const lang: 'pt' | 'en' | 'es' = isEn ? 'en' : (isEs ? 'es' : ((post.data as any).lang || 'pt'));
const baseSlug = slug.replace(/-(en|es)$/, '');

// Suporte tanto para Astro 4 (post.render()) quanto para Astro 5 (render(post))
const rendered = typeof (post as any).render === 'function' ? await (post as any).render() : await render(post);
const Content = rendered.Content;
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  datePublished={post.data.datePublished}
  dateModified={post.data.dateModified}
  author={post.data.author}
  image={post.data.image}
  badge={post.data.badge}
  readTime={post.data.readTime}
  keywords={post.data.keywords}
  lang={lang}
  baseSlug={baseSlug}
  translations={translations}
>
  <Content />
</ArticleLayout>
