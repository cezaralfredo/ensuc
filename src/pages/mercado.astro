<style is:global>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
a{text-decoration:none;color:inherit;}
:root{--deep:#060e09;--forest:#0d1f15;--dark:#142a1d;--green:#1e4d35;--mid:#2d6a4f;--light:#52b788;--gold:#c9a84c;--gold2:#e8c55a;--white:#f4f0e8;--gray:#8a9e8f;--border:rgba(201,168,76,0.18);--fd:'Playfair Display',Georgia,serif;--fa:'Oswald',sans-serif;--fb:'DM Sans',system-ui,sans-serif;--nav:72px;--tr:0.3s cubic-bezier(0.4,0,0.2,1);}
body{background:var(--deep);color:var(--white);font-family:var(--fb);font-weight:300;line-height:1.6;overflow-x:hidden;}
::-webkit-scrollbar{width:5px;}::-webkit-scrollbar-track{background:var(--forest);}::-webkit-scrollbar-thumb{background:var(--gold);border-radius:3px;}
nav{position:fixed;top:0;left:0;right:0;height:var(--nav);z-index:1000;display:flex;align-items:center;justify-content:space-between;padding:0 5%;background:rgba(6,14,9,0.96);backdrop-filter:blur(20px);box-shadow:0 1px 0 var(--border);}
.logo{font-family:var(--fa);font-weight:700;font-size:1.8rem;letter-spacing:.15em;color:var(--gold);display:flex;align-items:center;gap:8px;cursor:pointer;}
.logo span{color:var(--white);}.logo-dot{width:8px;height:8px;background:var(--gold);border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(1.6);}}
.nav-links{display:flex;align-items:center;gap:1.6rem;list-style:none;}
.nav-links a{font-family:var(--fa);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--gray);transition:color var(--tr);position:relative;}
.nav-links a::after{content:'';position:absolute;bottom:-4px;left:0;right:0;height:1px;background:var(--gold);transform:scaleX(0);transition:transform var(--tr);}
.nav-links a:hover,.nav-links a.active{color:var(--gold);}
.nav-links a.active::after,.nav-links a:hover::after{transform:scaleX(1);}
.nav-right{display:flex;align-items:center;gap:16px;}.lang-sw{display:flex;gap:4px;}
.lbtn{background:none;border:1px solid transparent;color:var(--gray);font-family:var(--fa);font-size:.7rem;cursor:pointer;padding:4px 8px;border-radius:2px;transition:all var(--tr);}
.lbtn.active,.lbtn:hover{border-color:var(--gold);color:var(--gold);}
.nav-cta{background:var(--gold);color:var(--deep);font-family:var(--fa);font-size:.75rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:10px 22px;border-radius:2px;transition:all var(--tr);cursor:pointer;border:none;}
.nav-cta:hover{background:var(--gold2);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:8px;}
.hamburger span{display:block;width:24px;height:1.5px;background:var(--white);}
.page-hero{padding:calc(var(--nav) + 80px) 5% 80px;position:relative;overflow:hidden;border-bottom:1px solid var(--border);}
.page-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 70% 50%,rgba(45,106,79,.12) 0%,transparent 60%),radial-gradient(ellipse at 10% 80%,rgba(201,168,76,.06) 0%,transparent 40%),var(--deep);}
.ph-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(201,168,76,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(201,168,76,.03) 1px,transparent 1px);background-size:60px 60px;}
.ph-inner{position:relative;z-index:1;max-width:800px;}
.breadcrumb{font-family:var(--fa);font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gray);margin-bottom:1.5rem;display:flex;align-items:center;gap:8px;}
.breadcrumb a{color:var(--gold);transition:opacity var(--tr);}
.breadcrumb a:hover{opacity:.7;}
.page-h1{font-family:var(--fd);font-size:clamp(2.4rem,5vw,4rem);font-weight:900;line-height:1.08;letter-spacing:-.02em;margin-bottom:1.2rem;}
.page-h1 em{font-style:italic;color:var(--gold);}
.page-sub{font-size:1.05rem;color:var(--gray);max-width:620px;line-height:1.75;}
.section{padding:80px 5%;}
.section.alt{background:var(--dark);border-top:1px solid var(--border);border-bottom:1px solid var(--border);}
.stag{font-family:var(--fa);font-size:.7rem;font-weight:400;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;gap:10px;margin-bottom:1rem;}
.stag::before{content:'';width:24px;height:1px;background:var(--gold);}
.sh2{font-family:var(--fd);font-size:clamp(1.8rem,3.5vw,2.8rem);font-weight:900;line-height:1.1;letter-spacing:-.02em;margin-bottom:2rem;}
.sh2 em{font-style:italic;color:var(--gold);}
.rv{opacity:0;transform:translateY(40px);transition:opacity .7s ease,transform .7s ease;}.rv.on{opacity:1;transform:translateY(0);}
.what-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;}
.what-text p{color:var(--gray);line-height:1.8;margin-bottom:1.2rem;font-size:.95rem;}
.what-text p strong{color:var(--white);font-weight:500;}
.co2-card{background:var(--dark);border:1px solid var(--border);padding:40px;text-align:center;position:relative;overflow:hidden;}
.co2-card::before{content:'CO₂';position:absolute;font-family:var(--fa);font-size:6rem;font-weight:700;color:rgba(201,168,76,.06);top:50%;left:50%;transform:translate(-50%,-50%);white-space:nowrap;}
.co2-big{font-family:var(--fa);font-size:clamp(3rem,6vw,5rem);font-weight:700;color:var(--gold);display:block;line-height:1;}
.co2-unit{font-family:var(--fa);font-size:.9rem;color:var(--gray);letter-spacing:.1em;margin-top:8px;display:block;}
.co2-sub{font-size:.8rem;color:var(--gray);margin-top:16px;padding-top:16px;border-top:1px solid var(--border);}
.stat-row{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);margin-top:1px;}
.stat-box{background:var(--dark);padding:24px 20px;text-align:center;}
.stat-box strong{font-family:var(--fa);font-size:1.4rem;font-weight:700;color:var(--gold);display:block;}
.stat-box span{font-size:.75rem;color:var(--gray);margin-top:4px;display:block;}
.flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border:1px solid var(--border);}
.fstep{background:var(--forest);padding:36px 28px;position:relative;}
.fstep-n{font-family:var(--fa);font-size:3.5rem;font-weight:700;color:rgba(201,168,76,.08);line-height:1;margin-bottom:12px;}
.fstep h4{font-family:var(--fa);font-size:.82rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem;}
.fstep p{font-size:.82rem;color:var(--gray);line-height:1.65;}
.fstep-arrow{position:absolute;top:36px;right:-1px;width:24px;height:24px;background:var(--gold);clip-path:polygon(0 50%,100% 0,100% 100%);z-index:2;}
.fstep:last-child .fstep-arrow{display:none;}
.types-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);}
.tcard{background:var(--forest);padding:48px 36px;position:relative;overflow:hidden;}
.tcard::after{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:var(--gold);}
.tcard h3{font-family:var(--fa);font-size:1rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;}
.tcard p{font-size:.9rem;color:var(--gray);line-height:1.75;margin-bottom:1.5rem;}
.tcard-tag{display:inline-block;font-family:var(--fa);font-size:.65rem;font-weight:600;letter-spacing:.15em;text-transform:uppercase;background:rgba(201,168,76,.12);border:1px solid rgba(201,168,76,.3);color:var(--gold);padding:5px 12px;margin-top:auto;}
.tc-icon{font-size:2rem;margin-bottom:1.2rem;}
.sbce-wrap{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;}
.sbce-card{background:var(--forest);border:1px solid var(--border);padding:40px;}
.sbce-card h3{font-family:var(--fa);font-size:.85rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-bottom:1.2rem;display:flex;align-items:center;gap:8px;}
.law-badge{background:var(--gold);color:var(--deep);font-family:var(--fa);font-size:.75rem;font-weight:700;letter-spacing:.06em;padding:8px 16px;display:inline-block;margin-bottom:1.5rem;}
.sbce-list{list-style:none;}
.sbce-list li{display:flex;align-items:flex-start;gap:10px;font-size:.87rem;color:var(--gray);padding:10px 0;border-bottom:1px solid rgba(201,168,76,.07);}
.sbce-list li::before{content:'▸';color:var(--gold);flex-shrink:0;margin-top:1px;}
.threshold-box{background:var(--dark);border:1px solid var(--border);padding:28px;margin-top:16px;}
.threshold-box h4{font-family:var(--fa);font-size:.72rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
.trow{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(201,168,76,.07);font-size:.84rem;}
.trow:last-child{border-bottom:none;}
.trow strong{color:var(--gold);font-family:var(--fa);}
.adv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--border);border:1px solid var(--border);}
.acard{background:var(--forest);padding:40px 28px;transition:background var(--tr);position:relative;overflow:hidden;}
.acard::before{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:var(--gold);transform:scaleX(0);transition:transform var(--tr);}
.acard:hover{background:var(--dark);}
.acard:hover::before{transform:scaleX(1);}
.acard-ico{font-size:1.6rem;margin-bottom:1rem;}
.acard h3{font-family:var(--fa);font-size:.85rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--white);margin-bottom:.6rem;}
.acard p{font-size:.83rem;color:var(--gray);line-height:1.65;}
.cop-grid{display:grid;grid-template-columns:1fr 2fr;gap:60px;align-items:start;}
.cop-badge{background:var(--green);border:1px solid var(--border);padding:36px;text-align:center;}
.cop-year{font-family:var(--fa);font-size:4rem;font-weight:700;color:var(--gold);display:block;line-height:1;}
.cop-loc{font-family:var(--fa);font-size:.78rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gray);margin-top:6px;}
.cop-date{font-size:.8rem;color:var(--gray);margin-top:10px;padding-top:10px;border-top:1px solid var(--border);}
.cop-items{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border);border:1px solid var(--border);}
.cop-item{background:var(--forest);padding:28px 24px;}
.cop-item h4{font-family:var(--fa);font-size:.78rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:var(--gold);margin-bottom:.5rem;}
.cop-item p{font-size:.82rem;color:var(--gray);line-height:1.6;}
.cta-strip{padding:80px 5%;background:var(--green);border-top:1px solid var(--border);text-align:center;}
.cta-strip h2{font-family:var(--fd);font-size:clamp(1.8rem,3vw,2.6rem);font-weight:900;margin-bottom:1rem;}
.cta-strip h2 em{font-style:italic;color:var(--gold);}
.cta-strip p{color:var(--gray);max-width:540px;margin:0 auto 2rem;line-height:1.75;}
.cta-row{display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;}
.btn-p{display:inline-flex;align-items:center;gap:8px;background:var(--gold);color:var(--deep);font-family:var(--fa);font-size:.82rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:14px 30px;border-radius:2px;transition:all var(--tr);border:none;cursor:pointer;}
.btn-p:hover{background:var(--gold2);transform:translateY(-2px);}
.btn-o{display:inline-flex;align-items:center;gap:8px;background:transparent;color:var(--white);font-family:var(--fa);font-size:.82rem;letter-spacing:.1em;text-transform:uppercase;padding:14px 30px;border:1px solid rgba(244,240,232,.2);border-radius:2px;transition:all var(--tr);cursor:pointer;}
.btn-o:hover{border-color:var(--gold);color:var(--gold);}
footer{background:var(--forest);border-top:1px solid var(--border);padding:48px 5% 28px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:48px;margin-bottom:48px;}
.foot-logo{font-family:var(--fa);font-weight:700;font-size:1.4rem;letter-spacing:.15em;color:var(--gold);margin-bottom:1rem;}
.foot-desc{font-size:.83rem;color:var(--gray);line-height:1.75;max-width:280px;}
.fcol h4{font-family:var(--fa);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);margin-bottom:1.2rem;}
.fcol ul{list-style:none;}
.fcol li{font-size:.83rem;color:var(--gray);padding:6px 0;cursor:pointer;transition:color var(--tr);}
.fcol li:hover{color:var(--white);}
.foot-bot{border-top:1px solid var(--border);padding-top:22px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:.76rem;color:var(--gray);}
.ods-row{display:flex;gap:8px;flex-wrap:wrap;}
.odsbadge{background:var(--forest);border:1px solid var(--border);padding:4px 10px;font-family:var(--fa);font-size:.62rem;letter-spacing:.1em;color:var(--gray);}
.wa-float{position:fixed;right:22px;bottom:22px;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;z-index:1200;box-shadow:0 8px 24px rgba(37,211,102,.35);transition:transform var(--tr),box-shadow var(--tr);cursor:pointer;}
.wa-float:hover{transform:translateY(-3px);box-shadow:0 14px 32px rgba(37,211,102,.5);}
.wa-float svg{width:30px;height:30px;fill:var(--white);}
@media(max-width:900px){.what-grid,.sbce-wrap,.cop-grid{grid-template-columns:1fr;}.types-grid,.adv-grid,.cop-items{grid-template-columns:1fr;}.flow-grid{grid-template-columns:1fr 1fr;}.footer-grid{grid-template-columns:1fr 1fr;}.nav-links{display:none;}.hamburger{display:flex;}.nav-links.open{display:flex;flex-direction:column;position:fixed;top:var(--nav);left:0;right:0;background:rgba(6,14,9,.98);padding:20px 5%;gap:0;}.nav-links.open li{border-bottom:1px solid var(--border);}.nav-links.open a{display:block;padding:14px 0;}}
@media(max-width:540px){.flow-grid{grid-template-columns:1fr;}.fstep-arrow{display:none;}}
</style>
