---
interface Props {
  activeNav?: string;
  lang?: 'pt' | 'en' | 'es';
  translations?: {
    pt?: string;
    en?: string;
    es?: string;
  };
}

const { activeNav, lang = 'pt', translations } = Astro.props;

// URLs para troca de idioma
const ptUrl = translations?.pt || (activeNav ? `/${activeNav}` : '/');
const enUrl = translations?.en || (activeNav ? `/?lang=en#/${activeNav}` : '/?lang=en');
const esUrl = translations?.es || (activeNav ? `/?lang=es#/${activeNav}` : '/?lang=es');
---

<header class="header-nav" id="main-header">
  <nav aria-label="Navegação principal">
    <a href="/" class="logo" aria-label="ENSUC Início">
      <img src="/logo-ensuc.webp" alt="ENSUC Soluções Ambientais" width="160" height="40" style="height:40px;width:auto;" />
    </a>

    <ul class="nav-links" id="nav-links">
      <li><a href="/mercado" class={activeNav === 'mercado' ? 'active' : ''}>Mercado de Carbono</a></li>
      <li><a href="/paa" class={activeNav === 'paa' ? 'active' : ''}>PAA</a></li>
      <li><a href="/simulador" class={activeNav === 'simulador' ? 'active' : ''}>Simulador Online</a></li>
      <li><a href="/biomas" class={activeNav === 'biomas' ? 'active' : ''}>Biomas</a></li>
      <li><a href="/marco" class={activeNav === 'marco' ? 'active' : ''}>Regulação</a></li>
      <li><a href="/financiamento" class={activeNav === 'financiamento' ? 'active' : ''}>Financiamento</a></li>
      <li><a href="/blog" class={activeNav === 'blog' ? 'active' : ''}>Blog</a></li>
      <li><a href="/#contato">Contato</a></li>
    </ul>

    <div class="nav-right">
      <div class="lang-sw" aria-label="Seleção de idioma">
        <a href={ptUrl} class={`lbtn ${lang === 'pt' ? 'active' : ''}`} title="Português">PT</a>
        <a href={enUrl} class={`lbtn ${lang === 'en' ? 'active' : ''}`} title="English">EN</a>
        <a href={esUrl} class={`lbtn ${lang === 'es' ? 'active' : ''}`} title="Español">ES</a>
      </div>

      <a href="/#contato" class="nav-cta">Começar Agora</a>

      <button class="hamburger" id="hamburger-btn" aria-label="Abrir menu de navegação" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .header-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--nav, 72px);
    z-index: 1000;
    background: rgba(6, 14, 9, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    transition: background 0.3s ease;
  }

  .header-nav nav {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    bottom: auto !important;
    height: 100% !important;
    max-width: 1300px;
    margin: 0 auto;
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    padding: 0 5%;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-links a {
    font-family: var(--fa);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray);
    transition: color var(--tr);
    padding: 6px 0;
    position: relative;
    text-decoration: none;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform var(--tr);
    transform-origin: left;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--gold);
  }

  .nav-links a:hover::after,
  .nav-links a.active::after {
    transform: scaleX(1);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* LANGUAGE SWITCHER */
  .lang-sw {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .lbtn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--gray);
    font-family: var(--fa);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 2px;
    transition: all var(--tr);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lbtn.active,
  .lbtn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .nav-cta {
    background: var(--gold);
    color: var(--deep);
    font-family: var(--fa);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 10px 20px;
    border-radius: 2px;
    transition: all var(--tr);
    text-decoration: none;
    display: inline-block;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--gold2);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(201, 168, 76, 0.3);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--white);
    transition: all var(--tr);
  }

  @media (max-width: 992px) {
    .nav-links {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .nav-links.open {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--nav);
      left: 0;
      right: 0;
      background: rgba(6, 14, 9, 0.98);
      border-bottom: 1px solid var(--border);
      padding: 24px 5%;
      gap: 0;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8);
    }

    .nav-links.open li {
      width: 100%;
      border-bottom: 1px solid rgba(201, 168, 76, 0.1);
    }

    .nav-links.open a {
      display: block;
      padding: 14px 0;
      font-size: 0.85rem;
    }
  }

  @media (max-width: 600px) {
    .nav-cta {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const links = document.getElementById('nav-links');
  if (btn && links) {
    btn.addEventListener('click', () => {
      const isOpen = links.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  }
</script>
