---
interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  badge?: string;
  readTime?: string;
}

const { title, description, slug, date, badge = 'Artigo', readTime = '5 min de leitura' } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(date);

const href = `/${slug}`;
---

<article class="article-card">
  <div class="card-meta">
    <span class="card-badge">{badge}</span>
    <span class="card-date">{formattedDate}</span>
  </div>
  <h3 class="card-title">
    <a href={href}>{title}</a>
  </h3>
  <p class="card-desc">{description}</p>
  <div class="card-foot">
    <span class="card-read">{readTime}</span>
    <a href={href} class="card-link" aria-label={`Ler artigo: ${title}`}>
      Ler Artigo <span>→</span>
    </a>
  </div>
</article>

<style>
  .article-card {
    background: var(--forest);
    border: 1px solid var(--border);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all var(--tr);
    position: relative;
    overflow: hidden;
  }

  .article-card::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--tr);
  }

  .article-card:hover {
    background: var(--dark);
    transform: translateY(-4px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
    border-color: rgba(201, 168, 76, 0.4);
  }

  .article-card:hover::before {
    transform: scaleX(1);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    gap: 12px;
  }

  .card-badge {
    display: inline-block;
    background: rgba(201, 168, 76, 0.1);
    border: 1px solid rgba(201, 168, 76, 0.25);
    color: var(--gold);
    font-family: var(--fa);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 2px;
  }

  .card-date {
    font-family: var(--fa);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--gray);
    text-transform: uppercase;
  }

  .card-title {
    font-family: var(--fd);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 1rem;
    color: var(--white);
  }

  .card-title a {
    color: inherit;
    transition: color var(--tr);
  }

  .card-title a:hover {
    color: var(--gold);
  }

  .card-desc {
    font-size: 0.92rem;
    color: var(--gray);
    line-height: 1.7;
    margin-bottom: 1.8rem;
    flex-grow: 1;
  }

  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(201, 168, 76, 0.12);
    padding-top: 14px;
    font-family: var(--fa);
    font-size: 0.75rem;
  }

  .card-read {
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .card-link {
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: gap var(--tr);
  }

  .card-link span {
    transition: transform var(--tr);
  }

  .article-card:hover .card-link span {
    transform: translateX(4px);
  }
</style>
